+// Android only: the Java overlay (org.xberecomp.GameActivity) reads and changes the settings the graphics panel has, and
+// pauses the game, through these three calls. They use only what app.h and host_pause.h already offer.
+#ifdef __ANDROID__
+#include <jni.h>
+
+#include <string>
+
+#include "app/app.h"
+#include "core/host_pause.h"
+
+namespace {
+
+std::string Text(JNIEnv* env, jstring s) {
+    if (!s) return {};
+    const char* chars = env->GetStringUTFChars(s, nullptr);
+    std::string out = chars ? chars : "";
+    if (chars) env->ReleaseStringUTFChars(s, chars);
+    return out;
+}
+
+}  // namespace
+
+extern "C" {
+
+// key: display (0 fullscreen, 1 borderless, 2 windowed), height (480, 720 or 1080), scale (render percent), aspect (0..3),
+// aniso (2, 4, 8, 16), fps (0 unlimited). Out-of-range values are ignored. The settings file is saved.
+JNIEXPORT void JNICALL Java_org_xberecomp_GameActivity_nativeSetSetting(JNIEnv* env, jclass, jstring jkey, jint value) {
+    const std::string key = Text(env, jkey);
+    app::Settings& s = app::Get();
+    if (key == "display") {
+        if (value < 0 || value > 2) return;
+        s.display_mode = static_cast<app::DisplayMode>(value);
+        app::ApplyDisplay();
+    } else if (key == "height") {
+        if (value != 480 && value != 720 && value != 1080) return;
+        // a fixed output size would shrink the window to that shape; keep the desktop mode and render at this height
+        s.render_height = static_cast<uint32_t>(value);
+        s.width = 0;
+        s.height = 0;
+        app::ApplyDisplay();
+    } else if (key == "scale") {
+        if (value < 25 || value > 300) return;
+        s.render_percent = static_cast<uint32_t>(value);
+    } else if (key == "aspect") {
+        if (value < 0 || value > 3) return;
+        s.aspect = static_cast<uint32_t>(value);
+    } else if (key == "aniso") {
+        if (value != 0 && value != 2 && value != 4 && value != 8 && value != 16) return;
+        s.aniso = static_cast<uint32_t>(value);
+    } else if (key == "fps") {
+        if (value < 0 || value > 1000) return;
+        s.fps_cap = static_cast<uint32_t>(value);
+    } else {
+        return;
+    }
+    app::Save();
+}
+
+// the same keys, plus paused (0 or 1); -1 for a key it does not know. height is 0 while the output is the desktop mode.
+JNIEXPORT jint JNICALL Java_org_xberecomp_GameActivity_nativeGetSetting(JNIEnv* env, jclass, jstring jkey) {
+    const std::string key = Text(env, jkey);
+    const app::Settings& s = app::Get();
+    if (key == "display") return static_cast<jint>(s.display_mode);
+    if (key == "height") return static_cast<jint>(s.render_height ? s.render_height : s.height);
+    if (key == "scale") return static_cast<jint>(s.render_percent);
+    if (key == "aspect") return static_cast<jint>(s.aspect);
+    if (key == "aniso") return static_cast<jint>(s.aniso);
+    if (key == "fps") return static_cast<jint>(s.fps_cap);
+    if (key == "paused") return host::Pause().Paused() ? 1 : 0;
+    return -1;
+}
+
+// a plain pause: the guest's clocks and audio stop, the window keeps running; not while the graphics panel is open
+JNIEXPORT void JNICALL Java_org_xberecomp_GameActivity_nativeTogglePause(JNIEnv*, jclass) {
+    if (app::GraphicsMenuOpen()) return;
+    host::Pause().Set(!host::Pause().Paused());
+}
+
+}  // extern "C"
+#endif
